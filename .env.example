WX_APPID=wxac2808104a5b6503
WX_SECRET=

MYSQL_ADDRESS=mysql:3306
MYSQL_HOST_PORT=3307
MYSQL_DATABASE=dance_academy
MYSQL_USERNAME=root
MYSQL_PASSWORD=请替换为高强度随机密码

# 生产环境必须替换；可用 openssl rand -hex 32 生成
JWT_SECRET=请替换为至少64位随机字符串
JWT_EXPIRE_HOURS=168

ADMIN_USERNAME=请替换为后台管理员账号
ADMIN_PASSWORD=请替换为高强度随机密码

WX_SUBSCRIBE_TEMPLATE_ID=
WX_MP_STATE=formal

# local 本地磁盘（需持久化挂载并定期备份）
# wx   微信云托管对象存储（正式环境，无需 SecretId/SecretKey）
# oss  阿里云 OSS（尚未接入）
STORAGE_TYPE=local

# 微信云托管控制台 → 对象存储 → 存储配置
COS_REGION=ap-shanghai
COS_BUCKET=
# 控制台里文件的访问前缀，例如 https://xxx.tcb.qcloud.la  不要末尾斜杠
COS_PUBLIC_BASE_URL=
