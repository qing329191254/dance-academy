# 本地 admin 开发时 API 代理目标（仅转发 /api 和 /uploads，不影响 Vite 前端模块）
# 对接云端：
VITE_API_PROXY_TARGET=https://springboot-1g7c-301404-6-1473444650.sh.run.tcloudbase.com

# 对接本地 Docker/IDE 后端时，复制为 .env.development.local 并改为：
